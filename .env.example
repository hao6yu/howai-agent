# HaoGPT Environment Configuration
# Copy this file to .env for local build-time config.
# Run with: flutter run --dart-define-from-file=.env
# Do not put server secrets in production mobile builds.

# OpenAI API
# Local development only. Do not include this in production mobile builds.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=howai-chat
OPENAI_CHAT_MINI_MODEL=howai-chat-mini

# Optional: secure proxy endpoint (recommended for production)
# If set, the app sends OpenAI requests to this backend URL instead of OpenAI directly.
OPENAI_PROXY_BASE_URL=

# ElevenLabs (optional - for voice features)
# Production should use the Supabase proxy. Do not ship ELEVENLABS_API_KEY.
ELEVENLABS_PROXY_BASE_URL=
ELEVENLABS_API_KEY=
# Legacy single-agent key (kept for backward compatibility):
ELEVENLABS_AGENT_ID=your_elevenlabs_convai_agent_id_here
# Preferred voice-specific keys:
ELEVENLABS_AGENT_ID_MALE=your_elevenlabs_male_agent_id_here
ELEVENLABS_AGENT_ID_FEMALE=your_elevenlabs_female_agent_id_here

# Google APIs (for location/maps features)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase (optional - for cloud sync)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
